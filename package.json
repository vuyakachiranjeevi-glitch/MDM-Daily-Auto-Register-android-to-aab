{
  "name": "mdm-daily-auto-register",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && python3 scripts/generate_clean_source_zip.py",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.js 2>/dev/null || npx tsx scripts/audit-test.ts",
    "verify:release": "npm run lint && npm run build && npx tsx scripts/test_mdm_calculations.ts && node scripts/build-twa.js --dev",
    "build:playstore": "node scripts/build-twa.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.7",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
}
