# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# TELECOM SMS GATEWAY CONFIGURATION FOR LIVE INDIAN MOBILE OTP DELIVERY
# Configure ONE of the following SMS providers to deliver live OTP messages.
# If none are configured, the system provides safe developer sandbox test mode.
# ==============================================================================

# Option 1: Fast2SMS (Recommended for India Quick OTP & Transactional DLT Route)
FAST2SMS_API_KEY=""
# FAST2SMS_DLT_TE_ID=""
# FAST2SMS_SENDER_ID="MDMAPS"

# Option 2: Twilio SMS (Global SMS Gateway with E.164 +91 mobile delivery)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# TWILIO_MESSAGING_SERVICE_SID=""

# Option 3: MSG91 (Indian DLT-approved OTP Flow)
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# MSG91_SENDER_ID="MDMAPS"

# Option 4: Textlocal (Indian SMS Gateway)
# TEXTLOCAL_API_KEY=""
# TEXTLOCAL_SENDER="TXTLCL"

# Option 5: Custom HTTP/Webhook SMS Gateway
# SMS_GATEWAY_URL="https://your-sms-api.com/send?mobile={MOBILE}&otp={OTP}&message={MESSAGE}"
# SMS_GATEWAY_AUTH_HEADER="Bearer YOUR_TOKEN"
# SMS_GATEWAY_METHOD="POST"

# Developer Sandbox Test Mode Setting (Set to true to explicitly permit sandbox mode)
# ALLOW_DEV_TEST_OTP="true"

# ==============================================================================
# FIREBASE / CLOUD FIRESTORE BACKEND CREDENTIALS
# Required for server-side Cloud Firestore synchronization in production.
# Provide service account credentials as JSON string or base64-encoded string.
# ==============================================================================
# FIREBASE_SERVICE_ACCOUNT_KEY=""
# FIREBASE_PROJECT_ID="smurfy-principle-g6rpq"
# FIRESTORE_DATABASE_ID="ai-studio-remixmiddaymealm-71a44c73-db3d-4a29-87e5-0569d0a93d24"

